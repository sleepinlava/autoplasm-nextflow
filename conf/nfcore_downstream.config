/*
 * nf-core downstream wiring: publishDir replication and per-tool CLI flags for
 * the vendored nf-core modules used by subworkflows/plasmid_downstream.nf
 * (typing 06, annotation 08, plasmid binning 05).
 *
 * This file is NOT loaded automatically: add
 *     includeConfig 'conf/nfcore_downstream.config'
 * to nextflow.config (kept out of it here by the refactor contract).
 *
 * ext.prefix closures are evaluated per task in the module script scope
 * (nf-core modules convention), so sample-specific naming is preserved.
 * publishDir saveAs receives the file path relative to the task dir; the
 * identity closure keeps subdirectory structure (e.g. per-sample result dirs).
 */
process {

    // ---------------- typing (06) ----------------
    withName: 'PLASMIDFINDER' {
        // -x (extended output) is hard-coded in the module; --legacy restores the
        // legacy JSON format used by the retired in-repo module
        ext.args   = '--legacy'
        ext.prefix = { "${meta.id}.plasmidfinder" }
        publishDir = [ [path: "${params.outdir}/06_plasmid_typing/plasmidfinder", mode: params.publish_dir_mode] ]
    }

    withName: 'MOB_TYPER' {
        // retired module ran mob_typer with --multi
        ext.args   = '--multi'
        ext.prefix = { "${meta.id}.mob_typer" }
        publishDir = [ [path: "${params.outdir}/06_plasmid_typing/mob_typer", mode: params.publish_dir_mode] ]
    }

    withName: 'CONJSCAN' {
        // Preserve contig groups; unknown topology is explicitly linear.
        ext.args   = '--db-type gembase --replicon-topology linear'
        ext.prefix = { "${meta.id}.conjscan" }
        publishDir = [ [path: "${params.outdir}/06_plasmid_typing/conjscan", mode: params.publish_dir_mode,
                        saveAs: { fn -> fn }] ]
    }

    withName: 'MACSYFINDER' {
        // This alias uses the same CONJScan plasmid models, not independent evidence.
        ext.args   = '--db-type gembase --replicon-topology linear'
        ext.prefix = { "${meta.id}.macsyfinder" }
        publishDir = [ [path: "${params.outdir}/06_plasmid_typing/macsyfinder", mode: params.publish_dir_mode,
                        saveAs: { fn -> fn }] ]
    }

    // ---------------- annotation (08) ----------------
    withName: 'BAKTA' {
        // retired module ran bakta with --skip-sorf (no --output: module writes flat files)
        ext.args   = '--skip-sorf'
        publishDir = [ [path: "${params.outdir}/08_annotation/bakta", mode: params.publish_dir_mode] ]
    }

    withName: 'AMRFINDERPLUS' {
        // module already runs nucleotide mode (-n); prefix restores the old file name
        ext.prefix = { "${meta.id}.amrfinder" }
        publishDir = [ [path: "${params.outdir}/08_annotation/amrfinderplus", mode: params.publish_dir_mode] ]
    }

    withName: 'ABRICATE' {
        ext.args   = { "--db ${params.abricate_db}" }
        ext.prefix = { "${meta.id}.${params.abricate_db}" }
        publishDir = [ [path: "${params.outdir}/08_annotation/abricate", mode: params.publish_dir_mode] ]
    }

    withName: 'INTEGRONFINDER' {
        // integron_finder writes Results_Integron_Finder_<input>/<replicon>.* ; keep structure
        publishDir = [ [path: "${params.outdir}/08_annotation/integronfinder", mode: params.publish_dir_mode,
                        saveAs: { fn -> fn }] ]
    }

    withName: 'PRODIGAL' {
        // -p meta as before; output_format 'gff' passed as value input in the subworkflow
        ext.args   = '-p meta'
        ext.prefix = { "${meta.id}.prodigal" }
        publishDir = [ [path: "${params.outdir}/08_annotation/prodigal", mode: params.publish_dir_mode] ]
    }

    withName: 'PROTEIN_INPUTS' {
        publishDir = [ [path: { "${params.outdir}/08_annotation/protein_inputs/${meta.id}" }, mode: params.publish_dir_mode] ]
    }

    withName: 'RGI' {
        ext.prefix = { "${meta.id}.rgi" }
        // publish only the result json/txt, not the temp/ scratch dir
        publishDir = [ [path: "${params.outdir}/08_annotation/rgi", mode: params.publish_dir_mode,
                        pattern: '*.{json,txt}'] ]
    }

    withName: 'EGGNOG_MAPPER' {
        publishDir = [ [path: "${params.outdir}/08_annotation/eggnog", mode: params.publish_dir_mode] ]
    }

    withName: 'MOB_SUITE_ANNOT' {
        publishDir = [ [path: { "${params.outdir}/08_annotation/mob_suite/${meta.id}" }, mode: params.publish_dir_mode] ]
    }

    withName: 'MOB_RECON' {
        publishDir = [ [path: { "${params.outdir}/05_plasmid_binning/mob_recon/${meta.id}" }, mode: params.publish_dir_mode] ]
    }

}
