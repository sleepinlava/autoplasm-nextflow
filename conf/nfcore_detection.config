/*
 * Detection-domain withName config for the nf-core module swap.
 *
 * GENOMAD 现为 nf-core genomad/endtoend（subworkflows/plasmid_detection.nf 中以
 * GENOMAD_ENDTOEND as GENOMAD 引入），模块自身不带 publishDir，旧自研模块的
 * 发布行为在此复刻。
 *
 * 注意（与旧 modules/detection/genomad.nf 的差异）：
 *  - 旧模块用脚本内 cp 额外发布 ${meta.id}_summary/ 下的三个汇总文件副本；
 *    nf-core 模块同时输出 ${prefix}/ 整目录与目录内文件，Nextflow 只发布整
 *    目录、自动跳过目录内文件，因此这三个顶层副本无法仅靠 publishDir 复刻。
 *    整目录以 ${meta.id}.genomad_out 名字发布，与旧目录发布一致。
 *  - nf-core 模块的 FASTA 输出为 *.fna.gz（脚本内 gzip），旧模块为未压缩 .fna。
 *  - 旧命令行的 --cleanup/--restart 不再传递：--cleanup 会删除 annotate/
 *    find_proviruses 等中间目录，导致模块非 optional 的 taxonomy/provirus emit
 *    缺失而使任务失败；--restart 在 Nextflow 全新 work 目录下无意义。
 *
 * 集成：本文件需在 nextflow.config 中 includeConfig（detection 域由本文件独占，
 * nextflow.config 的接线由统筹方处理）。
 */
process {
    withName: 'GENOMAD' {
        publishDir = [
            [
                path: { "${params.outdir}/04_plasmid_detection/genomad" },
                mode: params.publish_dir_mode,
                // ${prefix}/ 整目录（即模块的 genomad_results emit）改名为
                // ${meta.id}.genomad_out，复刻旧发布结构
                saveAs: { f -> f.tokenize('/')[0] + '.genomad_out' }
            ]
        ]
    }
}
