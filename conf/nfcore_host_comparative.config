/*
 * nf-core module wiring for host prediction (07) and comparative genomics (09).
 *
 * The vendored nf-core modules (metaphlan/metaphlan, kraken2/kraken2,
 * mmseqs/easycluster, blast/blastn) carry no publishDir directives and take
 * their tool-specific flags from ext.args, so the publish layout of the
 * retired in-house modules is replicated here.
 *
 * NOTE: this file is not self-activating. Add
 *   includeConfig 'conf/nfcore_host_comparative.config'
 * to nextflow.config (or to a profile) to enable it.
 */
process {
    withName: 'METAPHLAN' {
        publishDir = [
            [
                path    : { "${params.outdir}/07_host_prediction/metaphlan" },
                mode    : params.publish_dir_mode,
                pattern : '*_profile.txt',
                // nf-core emits <sample>_profile.txt; keep the historical
                // published name <sample>.metaphlan.tsv.
                saveAs  : { filename -> filename.replace('_profile.txt', '.metaphlan.tsv') }
            ]
        ]
    }

    withName: 'KRAKEN2' {
        publishDir = [
            [
                path    : { "${params.outdir}/07_host_prediction/kraken2" },
                mode    : params.publish_dir_mode,
                pattern : '*.kraken2.report.txt',
                // nf-core emits <sample>.kraken2.report.txt; keep the
                // historical published name <sample>.kraken2.report.
                saveAs  : { filename -> filename.replace('.kraken2.report.txt', '.kraken2.report') }
            ]
        ]
    }

    withName: 'MMSEQS2' {
        ext.args   = { "--min-seq-id ${params.mmseqs2_min_seq_id} -c ${params.mmseqs2_min_cov} --cov-mode 1" }
        publishDir = [
            [
                path    : { "${params.outdir}/09_comparative_genomics" },
                mode    : params.publish_dir_mode,
                pattern : '*_cluster.tsv'
            ],
            [
                path    : { "${params.outdir}/09_comparative_genomics" },
                mode    : params.publish_dir_mode,
                pattern : '*_rep_seq.fasta'
            ]
        ]
    }

    withName: 'BLASTN' {
        ext.args   = '-outfmt 6'
        publishDir = [
            [
                path    : { "${params.outdir}/09_comparative_genomics/blast" },
                mode    : params.publish_dir_mode,
                pattern : '*.txt',
                // nf-core emits <sample>.txt; keep the historical published
                // name <sample>.blast.tsv.
                saveAs  : { filename -> filename.replace('.txt', '.blast.tsv') }
            ]
        ]
    }
}
