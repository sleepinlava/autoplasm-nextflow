/*
 * nf-core MAG module wiring for the MAG_HOST subworkflow. The official
 * modules carry no publishDir, so the former local modules' layout under
 * 07_host_prediction/mag/ is replicated here, together with resource and
 * argument adaptations (GTDB-Tk --skip_ani_screen, formerly hardcoded in
 * the local module; the official GTDB-Tk module labels process_high_memory
 * which is not defined in nextflow.config, so the former process_highmem
 * class is restored per name).
 *
 * NOTE: this file is not self-activating. Add
 *   includeConfig 'conf/nfcore_mag.config'
 * to nextflow.config (or to a profile) to enable it.
 */
process {
    withName: 'METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/metabat2/depth", mode: params.publish_dir_mode]
        ]
    }
    withName: 'METABAT2' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/metabat2", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CONCOCT_CUTUPFASTA' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/concoct/cutup_fasta", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CONCOCT_CONCOCTCOVERAGETABLE' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/concoct/coverage", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CONCOCT_CONCOCT' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/concoct", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CONCOCT_MERGECUTUPCLUSTERING' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/concoct", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CONCOCT' {
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/concoct/bins", mode: params.publish_dir_mode]
        ]
    }
    withName: 'SEMIBIN' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/semibin", mode: params.publish_dir_mode]
        ]
    }
    withName: 'SCAFFOLDS2BIN_METABAT2' {
        ext.prefix = { "${meta.id}.metabat2" }
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/das_tool/contig2bin", mode: params.publish_dir_mode]
        ]
    }
    withName: 'SCAFFOLDS2BIN_CONCOCT' {
        ext.prefix = { "${meta.id}.concoct" }
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/das_tool/contig2bin", mode: params.publish_dir_mode]
        ]
    }
    withName: 'DAS_TOOL' {
        ext.args = '--write_bins'
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/das_tool", mode: params.publish_dir_mode]
        ]
    }
    withName: 'SCAFFOLDS2BIN_SEMIBIN' {
        ext.prefix = { "${meta.id}.semibin" }
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/das_tool/contig2bin", mode: params.publish_dir_mode]
        ]
    }
    withName: 'CHECKM2' {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/checkm2", mode: params.publish_dir_mode]
        ]
    }
    withName: 'GTDBTK' {
        cpus   = 16
        memory = 120.GB
        time   = 48.h
        // GTDB-Tk2.7.2 standard workflow includes ANI pre-screening. The old
        // --skip_ani_screen option was removed by the pinned upstream release.
        ext.args = ''
        publishDir = [
            [path: "${params.outdir}/07_host_prediction/mag/gtdbtk", mode: params.publish_dir_mode]
        ]
    }
}
