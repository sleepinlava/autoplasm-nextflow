/*
 * Wiring for the vendored nf-core modules that replaced the local
 * coverage / abundance / host-removal modules (branch refactor/nf-core-modules).
 *
 * Replicates the publish layout and output file names of the deleted local
 * processes:
 *   modules/coverage/*    -> 02_assembly/coverage/{bowtie2,minimap2,samtools,coverm}
 *   modules/abundance/*   -> 10_abundance/{bowtie2,minimap2,samtools,coverm}
 *   modules/host_removal/* -> 01_qc/host_removal/{bowtie2,minimap2}
 *
 * Chain labels ('.short'/'.long') and the minimap2 preset travel in the meta
 * map (meta.suffix / meta.preset) because the nf-core modules take them via
 * ext.prefix / ext.args rather than dedicated inputs.
 *
 * Deliberate changes vs. the old layout:
 *   - The legacy per-mapper SAMs (<id>.contig_alignment.sam, <id>.sam,
 *     <id>.host.sam) are gone; bowtie2 now emits sorted BAMs directly and
 *     host removal no longer keeps a host alignment. The sorted BAMs keep the
 *     old names under the old samtools dirs.
 *   - Bowtie2 index directories (build outputs) are intermediate-only and
 *     are not published.
 *   - Host-removal unmapped reads are now <id>.host.unmapped_{1,2}.fastq.gz
 *     (bowtie2) and <id>.host_removed_other.fastq.gz (unpaired minimap2 chain).
 */
process {

    // ---------------- contig coverage (02_assembly/coverage) ----------------
    withName: 'BOWTIE2_ALIGN_COVERAGE' {
        ext.prefix = { "${meta.id}.contig_alignment${meta.suffix}" }
        publishDir = [path: "${params.outdir}/02_assembly/coverage/samtools", mode: params.publish_dir_mode]
    }
    withName: 'MINIMAP2_ALIGN_COVERAGE' {
        ext.prefix = { "${meta.id}.contig_alignment${meta.suffix}" }
        ext.args   = { "-ax ${meta.preset}" }
        publishDir = [path: "${params.outdir}/02_assembly/coverage/samtools", mode: params.publish_dir_mode]
    }
    withName: 'SAMTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.contig_alignment" }
        publishDir = [path: "${params.outdir}/02_assembly/coverage/samtools", mode: params.publish_dir_mode]
    }
    withName: 'COVERM_CONTIG' {
        ext.args   = '--methods mean tpm rpkm --min-covered-fraction 0'
        ext.prefix = { "${meta.id}.contig_coverm" }
        ext.suffix = '.tsv'
        publishDir = [path: "${params.outdir}/02_assembly/coverage/coverm", mode: params.publish_dir_mode]
    }

    // ---------------- plasmid abundance (10_abundance) ----------------
    withName: 'BOWTIE2_ALIGN_ABUNDANCE' {
        ext.prefix = { "${meta.id}${meta.suffix ?: ''}" }
        publishDir = [path: "${params.outdir}/10_abundance/samtools", mode: params.publish_dir_mode]
    }
    withName: 'MINIMAP2_ALIGN_ABUNDANCE' {
        ext.prefix = { "${meta.id}${meta.suffix ?: ''}" }
        ext.args   = { "-ax ${meta.preset}" }
        publishDir = [path: "${params.outdir}/10_abundance/samtools", mode: params.publish_dir_mode]
    }
    withName: 'COVERM_ABUNDANCE' {
        ext.args   = '--methods mean tpm rpkm --min-covered-fraction 0'
        ext.prefix = { "${meta.id}${meta.suffix ?: ''}.coverm" }
        ext.suffix = '.tsv'
        publishDir = [path: "${params.outdir}/10_abundance/coverm", mode: params.publish_dir_mode]
    }
    withName: 'COVERM_ABUNDANCE_LONG' {
        ext.args   = '--methods mean tpm rpkm --min-covered-fraction 0'
        ext.prefix = { "${meta.id}${meta.suffix ?: ''}.coverm" }
        ext.suffix = '.tsv'
        publishDir = [path: "${params.outdir}/10_abundance/coverm", mode: params.publish_dir_mode]
    }

    // ---------------- host removal (01_qc/host_removal) ----------------
    withName: 'BOWTIE2_ALIGN_HOST' {
        ext.prefix = { "${meta.id}.host" }
        publishDir = [path: "${params.outdir}/01_qc/host_removal/bowtie2", mode: params.publish_dir_mode]
    }
    withName: 'MINIMAP2_ALIGN_HOST' {
        ext.prefix = { "${meta.id}.host" }
        ext.args   = { "-ax ${meta.preset}" }
        publishDir = [path: "${params.outdir}/01_qc/host_removal/minimap2", mode: params.publish_dir_mode]
    }
    withName: 'SAMTOOLS_VIEW_HOST' {
        ext.args   = '-f 4' // keep only unmapped reads
        ext.prefix = { "${meta.id}.host_removed" }
        publishDir = [path: "${params.outdir}/01_qc/host_removal/minimap2", mode: params.publish_dir_mode]
    }
    withName: 'SAMTOOLS_FASTQ_HOST' {
        ext.prefix = { "${meta.id}.host_removed" }
        publishDir = [path: "${params.outdir}/01_qc/host_removal/minimap2", mode: params.publish_dir_mode]
    }
}
