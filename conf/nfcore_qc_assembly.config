/*
 * nf-core module wiring for QC (01), basecalling (00), assembly (02),
 * assembly QC (03) and polishing (branch refactor/nf-core-modules).
 *
 * The vendored nf-core modules (fastp, fastqc, multiqc, nanoplot, filtlong,
 * hifiadapterfilt/hifiadapterfilt, samtools/fastq, megahit, spades, flye,
 * quast, medaka) carry no publishDir directives and take their tool-specific
 * flags from ext.args / ext.prefix, so the publish layout and product names
 * of the retired in-house modules are replicated here:
 *   modules/qc/*           -> 01_qc/{fastp,fastqc,nanoplot,filtlong,hifiadapterfilt}
 *   modules/basecalling/*  -> 00_input_validation/basecalling/samtools_fastq
 *   modules/assembly/*     -> 02_assembly/{megahit,metaspades,hybridspades,metaflye}
 *   modules/assembly_qc/*  -> 03_assembly_qc/quast
 *   modules/polishing/*    -> 03_assembly_qc/polishing/medaka
 *
 * Name changes vs the retired local modules (trace-count relevant):
 *   METASPADES/HYBRIDSPADES are nf-core SPADES under an alias,
 *   METAFLYE is nf-core FLYE under an alias,
 *   HIFIADAPTERFILT is HIFIADAPTERFILT_HIFIADAPTERFILT under an alias;
 *   every other process keeps its historical name.
 *
 * Deliberate changes vs the old layout:
 *   - Assembler/medaka/polisher outputs are now gzip-compressed
 *     (e.g. <id>.megahit.contigs.fa.gz, <id>.medaka.consensus.fa.gz).
 *   - Filtlong/samtools-fastq products are now gzipped
 *     (<id>.filtlong.fastq.gz, <id>.bam.fastq.gz).
 *   - The legacy whole-output directories (<id>.megahit_out, <id>.spades_out,
 *     <id>.flye_out, <id>.medaka_out, <id>.quast_out content dumps) are no
 *     longer published wholesale; only the named product files above ship.
 *   - QUAST now runs `quast.py --meta --max-ref-number 0` (nf-core module)
 *     instead of `metaquast.py`; the published dir keeps the name
 *     <id>.quast_out and the report keeps the name <id>.quast_report.tsv.
 *
 * NOTE: this file is not self-activating. Add
 *   includeConfig 'conf/nfcore_qc_assembly.config'
 * to nextflow.config (or to a profile) to enable it.
 */
process {

    // ---------------- QC: fastp (01_qc/fastp) ----------------
    withName: '^FASTP$' {
        // Local patch: paired clean reads keep the legacy
        // <id>_R1.clean.fastq.gz / <id>_R2.clean.fastq.gz names.
        publishDir = [
            path    : { "${params.outdir}/01_qc/fastp" },
            mode    : params.publish_dir_mode,
            pattern : '*.{fastq.gz,html,json}'
        ]
    }

    // ---------------- QC: fastqc raw/clean (01_qc/fastqc) ----------------
    withName: '^FASTQC$' {
        ext.prefix = { "${meta.id}.${meta.stage}" }
        publishDir = [
            path    : { "${params.outdir}/01_qc/fastqc" },
            mode    : params.publish_dir_mode,
            pattern : '*.{zip,html}'
        ]
    }
    withName: '^FASTQC_CLEAN$' {
        ext.prefix = { "${meta.id}.${meta.stage}" }
        publishDir = [
            path    : { "${params.outdir}/01_qc/fastqc" },
            mode    : params.publish_dir_mode,
            pattern : '*.{zip,html}'
        ]
    }

    // ---------------- QC: multiqc (01_qc) ----------------
    withName: '^MULTIQC$' {
        // meta.id is the report label ('multiqc_illumina'); keep the legacy
        // <label>_report.html product name.
        ext.prefix = { "${meta.id}_report" }
        publishDir = [
            path    : { "${params.outdir}/01_qc" },
            mode    : params.publish_dir_mode,
            pattern : '*.html'
        ]
    }
    withName: '^MULTIQC_ONT$' {
        ext.prefix = { "${meta.id}_report" }
        publishDir = [
            path    : { "${params.outdir}/01_qc" },
            mode    : params.publish_dir_mode,
            pattern : '*.html'
        ]
    }

    // ---------------- QC: nanoplot (01_qc/nanoplot) ----------------
    withName: '^NANOPLOT$' {
        publishDir = [
            path    : { "${params.outdir}/01_qc/nanoplot" },
            mode    : params.publish_dir_mode,
            // nf-core nanoplot writes flat per-task outputs; restore the
            // legacy per-sample report directory <id>.nanoplot_out/.
            saveAs  : { name -> "${meta.id}.nanoplot_out/${name}" }
        ]
    }

    // ---------------- QC: filtlong (01_qc/filtlong) ----------------
    withName: '^FILTLONG$' {
        ext.args   = { "--min_length ${params.filtlong_min_length} --keep_percent ${params.filtlong_keep_percent}" }
        ext.prefix = { "${meta.id}.filtlong" }
        publishDir = [
            path    : { "${params.outdir}/01_qc/filtlong" },
            mode    : params.publish_dir_mode,
            pattern : '*.fastq.gz'
        ]
    }

    // ---------------- QC: hifiadapterfilt (01_qc/hifiadapterfilt) ----------------
    withName: '^HIFIADAPTERFILT$' {
        // nf-core emits <id>.filt.fastq.gz; keep the historical published
        // name <id>.hifiadapterfilt.fastq.gz.
        publishDir = [
            path    : { "${params.outdir}/01_qc/hifiadapterfilt" },
            mode    : params.publish_dir_mode,
            pattern : '*.filt.fastq.gz',
            saveAs  : { name -> name.replace('.filt.fastq.gz', '.hifiadapterfilt.fastq.gz') }
        ]
    }

    // ---------------- basecalling: BAM -> FASTQ (00) ----------------
    withName: '^SAMTOOLS_FASTQ$' {
        publishDir = [
            path    : { "${params.outdir}/00_input_validation/basecalling/samtools_fastq" },
            mode    : params.publish_dir_mode,
            // Long-read uBAM records are unpaired, so samtools fastq buckets
            // them into the -0 "other" output: <id>_other.fastq.gz. Keep the
            // historical published name <id>.bam.fastq.gz.
            pattern : '*_other.fastq.gz',
            saveAs  : { name -> name.replace('_other.fastq.gz', '.bam.fastq.gz') }
        ]
    }

    // ---------------- assembly: megahit (02_assembly/megahit) ----------------
    withName: '^MEGAHIT$' {
        ext.args   = { "--memory ${params.megahit_memory_bytes}" }
        ext.prefix = { "${meta.id}.megahit" }
        publishDir = [
            path    : { "${params.outdir}/02_assembly/megahit" },
            mode    : params.publish_dir_mode,
            pattern : '*.contigs.fa.gz'
        ]
    }

    // ---------------- assembly: metaSPAdes (02_assembly/metaspades) ----------------
    withName: '^METASPADES$' {
        ext.args   = '--meta'
        ext.prefix = { "${meta.id}.metaspades" }
        publishDir = [
            path    : { "${params.outdir}/02_assembly/metaspades" },
            mode    : params.publish_dir_mode,
            pattern : '*.{contigs.fa.gz,assembly.gfa.gz,assembly_graph.fastg}'
        ]
    }

    // ---------------- assembly: hybridSPAdes (02_assembly/hybridspades) ----------------
    withName: '^HYBRIDSPADES$' {
        ext.args   = '--meta'
        ext.prefix = { "${meta.id}.hybridspades" }
        publishDir = [
            path    : { "${params.outdir}/02_assembly/hybridspades" },
            mode    : params.publish_dir_mode,
            pattern : '*.{contigs.fa.gz,assembly.gfa.gz,assembly_graph.fastg}'
        ]
    }

    // ---------------- assembly: metaFlye (02_assembly/metaflye) ----------------
    withName: '^METAFLYE$' {
        ext.args   = '--meta'
        ext.prefix = { "${meta.id}.metaflye" }
        publishDir = [
            path    : { "${params.outdir}/02_assembly/metaflye" },
            mode    : params.publish_dir_mode,
            pattern : '*.{fasta.gz,gfa.gz,gv.gz,txt}'
        ]
    }

    // ---------------- assembly QC: quast (03_assembly_qc/quast) ----------------
    withName: '^QUAST$' {
        ext.args   = '--meta --max-ref-number 0'
        ext.prefix = { "${meta.id}.quast_out" }
        publishDir = [
            [
                path    : { "${params.outdir}/03_assembly_qc/quast" },
                mode    : params.publish_dir_mode,
                pattern : '*.tsv',
                // nf-core emits <id>.quast_out.tsv; keep the historical
                // published name <id>.quast_report.tsv.
                saveAs  : { name -> name.replace('.quast_out.tsv', '.quast_report.tsv') }
            ],
            [
                path    : { "${params.outdir}/03_assembly_qc/quast" },
                mode    : params.publish_dir_mode,
                pattern : '*.quast_out'
            ]
        ]
    }

    // ---------------- polishing: medaka (03_assembly_qc/polishing/medaka) ----------------
    withName: '^MEDAKA$' {
        ext.prefix = { "${meta.id}.medaka.consensus" }
        publishDir = [
            path    : { "${params.outdir}/03_assembly_qc/polishing/medaka" },
            mode    : params.publish_dir_mode,
            pattern : '*.fa.gz'
        ]
    }
}
