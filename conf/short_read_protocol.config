/* Opt-in protocol main chain; existing platform defaults remain available. */
params {
    short_read_protocol = true
    protocol_host_models = true
    protocol_evolution = true
    protocol_strain = true
    platform = 'illumina'
    host_prediction_tools = []
    short_read_assembler = 'metaspades'
    plasmid_binning_tools = ['plasmaag']
    plasmid_detection_tools = ['genomad']
    consensus_method = 'single_tool'
    typing_tools = ['mob_typer']
    annotation_optional_tools = ['eggnog_mapper']
    comparative_tools = []
    mag_tools = ['plasmaag', 'checkm2', 'gtdbtk']
    run_differential_internal = false
    run_ancombc2 = true
    beta_normalization = 'tss'
}
process {
    withName: 'PROTOCOL_PROTEIN_FAMILIES' {
        ext.args = { "--dbtype 1 --min-seq-id ${params.protocol_protein_identity} -c ${params.protocol_protein_coverage} --cov-mode 0 --cluster-mode 2" }
    }
    withName: 'SYSTEM_DIVERSITY' {
        publishDir = [path: "${params.outdir}/11_diversity/systems", mode: params.publish_dir_mode]
    }
    withName: 'PLASMID_DIVERSITY' {
        publishDir = [path: "${params.outdir}/11_diversity/plasmids", mode: params.publish_dir_mode]
    }
    withName: 'PLASMID_ANCOMBC2' {
        publishDir = [path: "${params.outdir}/11_diversity/plasmids/ancombc2", mode: params.publish_dir_mode]
    }
    withName: 'SYSTEM_ANCOMBC2' {
        publishDir = [path: "${params.outdir}/11_diversity/systems/ancombc2", mode: params.publish_dir_mode]
    }
    withName: 'CATALOGUE_CLUSTER_COMPLETE|CATALOGUE_CLUSTER_CIRCULAR|CATALOGUE_CLUSTER_FRAGMENT' {
        ext.args = { "--min-seq-id ${params.catalogue_identity} -c ${params.catalogue_coverage} --cov-mode 0 --cluster-mode 2 --seq-id-mode 0" }
    }
}
process {
    withName: 'AMRFINDERPLUS' {
        ext.args = '--plus'
    }
    withName: 'BAKTA' {
        ext.args = '--skip-sorf --keep-contig-headers'
    }
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,container'
}
process {
    withName: 'DIVERSITY|PLASMID_DIVERSITY|SYSTEM_DIVERSITY|PLASMID_CONSENSUS|PLASMID_STRUCTURE|PROTOCOL_FUNCTION_ENRICHMENT|REPORT' {
        conda = "${projectDir}/envs/protocol_r.yml"
    }
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}
