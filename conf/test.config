/*
 * Real-tool smoke test using pinned nf-core/test-datasets fixtures.
 * First run tests/nf-test/prepare_data.py; see tests/nf-test/README.md.
 * Combine with an execution profile, e.g. -profile test,docker.
 * The small geNomad database is for execution tests, not accuracy benchmarks.
 */
params {
    samplesheet = "${System.getenv('AUTOPLASM_TEST_DATA') ?: "${projectDir}/results/nf-test/upstream-data"}/${params.platform}.tsv"
    genomad_db = "${System.getenv('AUTOPLASM_TEST_DATA') ?: "${projectDir}/results/nf-test/upstream-data"}/databases/genomad_db"
    outdir = 'results/test'
    run_fastqc = true
    run_multiqc = true
    host_reference = null

    plasmid_detection_tools = ['genomad']
    plasmid_binning_tools = []
    typing_tools = []
    typing_optional_tools = []
    annotation_tools = ['prodigal']
    annotation_optional_tools = []
    host_prediction_tools = []
    mag_tools = []
    host_plasmid_linking = false
    comparative_tools = []
    comparative_optional_tools = []
    run_diversity = true
    min_diversity_samples = 3
    min_group_replicates = 3
    run_differential_internal = true
    run_differential_deseq2 = false
    run_network = false
    megahit_memory_bytes = 2000000000
}

process {
    resourceLimits = [cpus: 2, memory: '4 GB', time: '1 h']
    // Match nf-core/mag's tiny database: its subset lacks the neural model.
    withName: '.*:GENOMAD' {
        ext.args = '--cleanup --disable-nn-classification'
    }
}
