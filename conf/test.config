/*
 * Test profile: tiny resource caps and all optional tools off. Requires a
 * samplesheet with small test reads plus a geNomad database to actually run;
 * see assets/samplesheet_example.tsv for the expected layout.
 */
params {
    outdir          = 'results/test'
    run_fastqc      = false
    run_multiqc     = false
    host_reference  = null

    plasmid_detection_tools = ['genomad']
    plasmid_binning_tools   = []
    typing_tools            = ['plasmidfinder', 'mob_typer']
    typing_optional_tools   = []
    annotation_tools        = ['bakta', 'amrfinderplus', 'isescan', 'integronfinder']
    annotation_optional_tools = []
    host_prediction_tools   = ['metaphlan']
    mag_tools               = []
    host_plasmid_linking    = false
    run_diversity           = true
    run_differential_internal = true
    run_differential_deseq2 = false
    run_network             = false

    megahit_memory_bytes = 4000000000   // ~4 GB cap for test data
}

process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'
}
