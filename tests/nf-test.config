// Adapted from nf-core/mag and nf-core/modules; see nf-test/UPSTREAM.md.
config {
    testsDir = '.'
    workDir = System.getenv('NFT_WORKDIR') ?: 'results/nf-test/work'
    configFile = 'tests/nf-test/nextflow.config'
    profile = ''
    plugins {
        load 'nft-utils@1.2.1'
        load 'nft-bam@0.7.0'
    }
}
