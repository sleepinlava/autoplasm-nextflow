// Domain configs for vendored nf-core modules (this file is loaded with -C,
// which bypasses the project nextflow.config, so the includes must be repeated)
includeConfig '../../conf/nfcore_upstream.config'
includeConfig '../../conf/nfcore_qc_assembly.config'
includeConfig '../../conf/nfcore_detection.config'
includeConfig '../../conf/nfcore_downstream.config'
includeConfig '../../conf/nfcore_mag.config'
includeConfig '../../conf/nfcore_host_comparative.config'

process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    errorStrategy = 'terminate'
}

conda.enabled = false
docker.enabled = false
singularity.enabled = false

// Output oracles must resolve the recorded task directory, never the caller's cwd.
trace.fields = 'task_id,hash,native_id,name,status,exit,workdir'

params.outdir = 'results/test'
params.publish_dir_mode = 'copy'
params.link_min_similarity = 0.7
params.link_correlation_method = 'pearson'
params.link_min_correlation = 0.5
params.run_fastqc = true
params.run_multiqc = true
params.host_plasmid_linking = true
params.host_linking_methods = ['sequence']
params.host_linking_optional_methods = []
params.host_prediction_tools = []
params.comparative_tools = ['mmseqs2']
params.comparative_optional_tools = []
params.with_taxonomy = false
params.test_comparative_empty = false
params.omit_mag = false
params.omit_taxonomy = false
params.empty_plasmids = false
params.duplicate_keys = false
params.duplicate_mag_keys = false
params.duplicate_taxonomy_keys = false
params.include_fastp_json = false
params.extra_alias_tests = false
params.sample_id = 'S1'
params.ids = 'A__B.v1'
params.enable_crispr = true
params.direct_module = false
