// Test-only overlays. Upstream module test cases and snapshots stay unmodified.
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/618f1541382c4ad49eff566dadf13d5ccbd0ebb4/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/f450b2e3f8d45b6101978ddeda7e1a522b9be25b/'
    test_data_base = 'https://raw.githubusercontent.com/nf-core/test-datasets/618f1541382c4ad49eff566dadf13d5ccbd0ebb4'
    publish_dir_mode = 'copy'
}
process {
    resourceLimits = [cpus: 2, memory: '7 GB', time: '1 h']
}
profiles {
    native {
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
    }
    podman {
        podman.enabled = true
    }
    // W2 P3 suite-only overlay: SAMTOOLS_INDEX (custom bridge in
    // modules/mag/samtools_index.nf) declares no container and native samtools
    // is absent on this host, so nodes-mag-samtools-index runs with
    // --profile podman,w2mag to pin one without touching the module.
    w2mag {
        process {
            withName: 'SAMTOOLS_INDEX' {
                container = 'community.wave.seqera.io/library/htslib_samtools:1.24--d697cfb9dce007cd'
            }
        }
    }
    // W2 P3 suite-only overlay: the SPADES scaffolding in
    // tests/nf-test/workflows/spades_minigut_fastg.nf must reproduce the
    // production metaSPAdes run (subworkflows/illumina.nf + qc_assembly
    // config), so the scapp/recycler suites run with --profile podman,w2spades.
    w2spades {
        process {
            withName: 'SPADES' {
                ext.args = '--meta'
                ext.prefix = { "${meta.id}.metaspades" }
            }
        }
    }
}
