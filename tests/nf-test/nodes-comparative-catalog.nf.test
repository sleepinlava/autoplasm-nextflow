// P3 real-data node test: PLASMID_CATALOG_PREPARE (comparative domain).
// Input: pinned nf-core/test-datasets pUTI89 plasmid (AUTOPLASM_TEST_DATA,
// prepared by prepare_data.py --dataset real-nodes).
// Backend: native (system R + Biostrings; no container engine).
// Assertions use upstream-pinned facts (NC_007941.1, 114230 bp), not snapshots.
nextflow_process {
    name 'P3 real node: PLASMID_CATALOG_PREPARE'
    script '../../modules/comparative/catalog_prepare.nf'
    process 'PLASMID_CATALOG_PREPARE'
    tag 'P3'
    tag 'comparative'
    tag 'backend-native'

    test('pUTI89 plasmid fasta becomes sample-tagged catalog input') {
        when {
            process {
                """
                input[0] = [ file("${System.getenv('AUTOPLASM_TEST_DATA')}/pUTI89.plasmid_contigs.fasta", checkIfExists: true) ]
                input[1] = file("${new File('bin/plasmid_catalog_prepare.R').absolutePath}", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert process.out.combined.size() == 1
            def lines = path(process.out.combined[0]).text.readLines()
            // One sequence in, one record out; identifier is sample|contig.
            assert lines.count { it.startsWith('>') } == 1
            assert lines[0] == '>pUTI89|NC_007941.1'
            assert lines.drop(1).join().replaceAll(/\s/, '').length() == 114230
            assert path(process.out.samples[0]).text.readLines() == ['sample_id', 'pUTI89']
            assert process.out.cohort_provenance[0][5] == 'pUTI89'
        }
    }
}
