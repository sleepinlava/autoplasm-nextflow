// P3 real-data node test: SCAPP_DETECT (detection domain).
// Real minigut illumina pair is assembled by vendored SPADES (--meta,
// w2spades profile) into a genuine metaSPAdes assembly_graph.fastg
// (scaffolding workflow, the production graph contract from
// subworkflows/illumina.nf), then SCAPP mines that graph with the same reads.
// Backend: podman (spades + scapp images).
// Assertions use upstream-pinned facts (minigut assembly), not snapshots.
nextflow_pipeline {
    name 'P3 real node: SCAPP_DETECT on a real metaSPAdes assembly graph'
    script 'tests/nf-test/workflows/scapp_detect_real.nf'
    tag 'P3'
    tag 'detection'
    tag 'backend-podman'

    test('metaSPAdes graph of real minigut illumina reads mined by scapp with the same reads') {
        when {
            params {
                test_data = "${System.getenv('AUTOPLASM_TEST_DATA')}"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().isEmpty()
            // Real execution evidence: assembly + graph mining both ran.
            def tasks = workflow.trace.succeeded().collect { it.name }
            assert tasks.any { it.startsWith('MINIGUT_FASTG:SPADES') }
            assert tasks.any { it.startsWith('SCAPP_DETECT') }
            // The fasta output always exists (module concatenates confident
            // cycles, possibly empty); the scapp output dir must be populated.
            def fastas = getAllFilesFromDir(params.outdir,
                include: ['04_plasmid_detection/scapp/*.scapp.fasta'])
            assert fastas.size() == 1
            def scappFiles = getAllFilesFromDir(params.outdir,
                include: ['04_plasmid_detection/scapp/minigut.scapp_out/**'])
            assert scappFiles.size() >= 1
        }
    }
}
