// P3 real-data node test: LINK_LONGREAD (host-plasmid linking domain).
// Fixed upstream synthetic minigut reads are aligned to its assembly with
// minimap2+samtools (test scaffolding workflow), then the R bridge counter runs.
// First-five contigs are an explicit partition, not biological plasmid truth.
// A separate constructed split-read case guarantees a known nonempty counter.
// Native and podman deployment evidence must be recorded separately.
nextflow_pipeline {
    name 'P3 real node: LINK_LONGREAD on real minigut ONT alignment'
    script 'tests/nf-test/workflows/link_longread_real.nf'
    tag 'P3'
    tag 'linking'
    tag 'backend-podman'

    test('minigut ONT reads aligned to minigut assembly feed bridge counting') {
        when {
            params {
                test_data = "${System.getenv('AUTOPLASM_TEST_DATA')}"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().isEmpty()
            // Real alignment happened: minimap2+samtools task and the R task.
            def tasks = workflow.trace.succeeded().collect { it.name }
            assert tasks.any { it.startsWith('ALIGN_FOR_LINK') }
            assert tasks.any { it.startsWith('LINK_LONGREAD') }
            def links = getAllFilesFromDir(params.outdir,
                include: ['07_host_prediction/linking/longread/*.longread_bridge_links.tsv'])
            assert links.size() == 1
            def root = System.getenv('AUTOPLASM_TEST_DATA')
            def command = ['python3', new File('tests/check_longread_native.py').absolutePath,
                '--assembly', "${root}/minigut.fasta", '--reads', "${root}/test_data/minigut_reads.fastq.gz",
                '--plasmids', "${params.outdir}/test_inputs/longread/plasmid_contigs.fasta",
                '--sam', "${params.outdir}/test_inputs/longread/minigut_ont.sam.gz",
                '--links', links[0].toString(), '--output', "${params.outdir}/independent-longread.json"]
            def oracle = new ProcessBuilder(command.collect { it.toString() }).redirectErrorStream(true).start()
            def log = oracle.inputStream.text
            assert oracle.waitFor() == 0: log
            assert new groovy.json.JsonSlurper().parse(new File(params.outdir, 'independent-longread.json')).pass
        }
    }

    test('explicit synthetic split-read control reaches a nonempty native bridge count') {
        when {
            params {
                test_data = "${System.getenv('AUTOPLASM_LONGREAD_CONTROL_DATA')}"
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.failed().isEmpty()
            assert workflow.trace.succeeded().size() == 2
            def root = System.getenv('AUTOPLASM_LONGREAD_CONTROL_DATA')
            def command = ['python3', new File('tests/check_longread_native.py').absolutePath,
                '--assembly', "${root}/minigut.fasta", '--reads', "${root}/test_data/minigut_reads.fastq.gz",
                '--plasmids', "${params.outdir}/test_inputs/longread/plasmid_contigs.fasta",
                '--sam', "${params.outdir}/test_inputs/longread/minigut_ont.sam.gz",
                '--links', "${params.outdir}/07_host_prediction/linking/longread/minigut_ont.longread_bridge_links.tsv",
                '--control-manifest', "${root}/control.json", '--output', "${params.outdir}/independent-longread.json"]
            def oracle = new ProcessBuilder(command.collect { it.toString() }).redirectErrorStream(true).start()
            def log = oracle.inputStream.text
            assert oracle.waitFor() == 0: log
            def checked = new groovy.json.JsonSlurper().parse(new File(params.outdir, 'independent-longread.json'))
            assert checked.pass && checked.known_positive_control
            assert checked.expected_links.size() == 1 && checked.expected_links[0].reads == 2
        }
    }
}
