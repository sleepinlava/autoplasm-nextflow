// Adapt nf-core/mag's tiny-database native integration test, not a stub run.
// Deliberately test core processing without downloading unrelated full databases.
params {
    genomad_db = "${System.getenv('AUTOPLASM_TEST_DATA')}/databases/genomad_db"
    typing_tools = []
    typing_optional_tools = []
    annotation_tools = ['prodigal']
    annotation_optional_tools = []
    host_prediction_tools = []
    mag_tools = []
    host_plasmid_linking = false
    comparative_tools = []
    comparative_optional_tools = []
    run_fastqc = true
    run_multiqc = true
    run_diversity = true
    min_diversity_samples = 3
    min_group_replicates = 3
    run_network = false
    run_differential_deseq2 = false
    megahit_memory_bytes = 2000000000
}
process {
    withName: '.*' { cpus = 2; memory = '4 GB'; time = '30 min' }
    withName: '.*:GENOMAD' { ext.args = '--cleanup --disable-nn-classification' }
}
