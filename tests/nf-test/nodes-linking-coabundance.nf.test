// P3 real-data node test: LINK_COABUNDANCE (host-plasmid linking domain).
// Input: the real merged plasmid abundance table produced by the P4 ENA run
// (results/nf-test/ena-multi/cross/, see PROVENANCE.md). MetaPhlAn host
// profiles are unavailable (database ~4 GB, blocked), so the host channel is
// empty and the contract is a valid header-only links table.
// Backend: podman (autoplasm-r-analysis image).
nextflow_process {
    name 'P3 real node: LINK_COABUNDANCE'
    script '../../modules/linking/coabundance.nf'
    process 'LINK_COABUNDANCE'
    tag 'P3'
    tag 'linking'
    tag 'backend-podman'

    test('real ENA plasmid abundance table with empty host profiles') {
        when {
            process {
                """
                input[0] = file("${System.getenv('ENA_TEST_DATA')}/cross/plasmid_abundance.tsv", checkIfExists: true)
                input[1] = [ [], [] ]
                """
            }
        }
        then {
            assert process.success
            assert process.out.links.size() == 1
            def lines = path(process.out.links[0]).text.readLines()
            assert lines.size() == 1
            assert lines[0].split('\t').size() >= 2
        }
    }
}
