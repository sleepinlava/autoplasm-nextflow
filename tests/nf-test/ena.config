// Legacy ENA 16S amplicon execution overlay (not shotgun P4): runs assemble to
// short contigs only (e.g. SRR19638270: 28 contigs >=200 bp, 0 >=500 bp).
// QUAST's default --min-contig 500 would exit 4 on such real assemblies, so
// this historical test profile lowers the threshold to keep QUAST statistics.
// Short assemblies do not establish low biomass; see TT-013 and the data lock.
// Production config (conf/nfcore_qc_assembly.config) is unchanged.
includeConfig './integration.config'

process {
    withName: '^QUAST$' {
        ext.args = '--min-contig 200'
    }
}
