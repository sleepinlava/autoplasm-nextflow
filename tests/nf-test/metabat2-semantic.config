includeConfig './nextflow.config'
includeConfig '../../conf/nfcore_mag.config'

// Test-only selection. Empty means the unchanged module defaults. The second
// case uses the fixed vendored suite's permissive arguments, never production.
process {
    withName: 'METABAT2' {
        ext.args = params.metabat_test_args ?: ''
    }
}
