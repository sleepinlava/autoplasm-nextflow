new file mode 100644
--- /dev/null
+++ b/tests/check_metabat2_native.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Independent fixed-fixture membership/DNA/depth oracle; no MAG-quality claim."""
+import argparse
+from collections import defaultdict
+import csv
+import gzip
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def fasta(path):
+    result = {}
+    with gzip.open(path, 'rt') as stream:
+        for line in stream:
+            if line.startswith('>'):
+                name = line[1:].split()[0]
+                assert name not in result, 'Duplicate FASTA ID'
+                result[name] = ''
+            elif line.strip():
+                assert result
+                result[name] += line.strip()
+    assert result and all(result.values())
+    return result
+
+
+def check(fixture, products, mode):
+    lock = json.loads((ROOT / 'tests/nf-test/real-nodes-datasets.lock.json').read_text())
+    for name in ['contigs.fasta.gz', 's1.sorted.bam', 's1.sorted.bam.bai']:
+        expected = next(row for row in lock['files'] if row.get('path', '').endswith('/binning/multisample/' + name))
+        data = (fixture / name).read_bytes()
+        assert len(data) == expected['size']
+        assert hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest() == expected['git_blob_sha1'], 'Fixed fixture identity differs'
+    source = fasta(fixture / 'contigs.fasta.gz')
+    with gzip.open(products / 'depth/binning_s1.txt.gz', 'rt') as stream:
+        reader = csv.DictReader(stream, delimiter='\t')
+        assert reader.fieldnames == ['contigName', 'contigLen', 'totalAvgDepth', 's1.sorted', 's1.sorted-var']
+        rows = list(reader)
+    assert len(rows) == len(source)
+    depth = {row['contigName']: row for row in rows}
+    assert set(depth) == set(source)
+    for key, row in depth.items():
+        assert int(row['contigLen']) == len(source[key])
+        assert all(math.isfinite(float(row[column])) and float(row[column]) >= 0 for column in ['totalAvgDepth', 's1.sorted', 's1.sorted-var'])
+    with gzip.open(products / 'binning_s1.tsv.gz', 'rt') as stream:
+        membership = list(csv.reader(stream, delimiter='\t'))
+    assert membership and all(len(row) == 2 and row[0] in source and re.fullmatch(r'[0-9]+', row[1]) for row in membership)
+    assert len({row[0] for row in membership}) == len(membership)
+    declared = defaultdict(set)
+    for contig, label in membership:
+        if label != '0':
+            declared[label].add(contig)
+    emitted, seen = {}, set()
+    for path in products.glob('*.fa.gz'):
+        match = re.fullmatch(r'binning_s1\.([0-9]+)\.fa\.gz', path.name)
+        assert match, 'Unexpected auxiliary/output FASTA in this fixture'
+        dna = fasta(path)
+        assert not seen.intersection(dna), 'Contig emitted more than once'
+        assert all(key in source and value == source[key] for key, value in dna.items()), 'Foreign ID or changed bin DNA'
+        seen.update(dna)
+        emitted[match[1]] = set(dna)
+    # Fixed upstream2.17 output_bins() uses internal cluster key+1 in the
+    # matrix, and an independent sequential bin_id in FASTA filenames.
+    # Compare the complete partitions; those two numeric labels can differ.
+    declared_partition = {frozenset(members) for members in declared.values()}
+    emitted_partition = {frozenset(members) for members in emitted.values()}
+    assert len(emitted) == len(declared) and emitted_partition == declared_partition, 'Membership partition and emitted bins disagree'
+    if mode == 'default-empty':
+        eligible = {key for key, row in depth.items() if len(source[key]) >= 2500 and float(row['totalAvgDepth']) >= 1}
+        # The maximum eligible DNA is smaller than the declared 200kb bin
+        # minimum. This predicts zero bins independently of the first run.
+        assert 0 < sum(len(source[key]) for key in eligible) < 200000
+        assert not emitted and {row[0] for row in membership} == eligible
+    else:
+        assert emitted and seen, 'Upstream permissive settings must exercise nonempty bin publication'
+        assert all(len(source[key]) >= 1500 and float(depth[key]['totalAvgDepth']) >= .1 for key in seen)
+    return {'pass': True, 'mode': mode, 'source_contigs': len(source), 'depth_rows': len(rows),
+            'membership_rows': len(membership), 'bins': len(emitted), 'binned_contigs': len(seen),
+            'binned_bases': sum(len(source[key]) for key in seen),
+            'scope': 'Fixed upstream software fixture, depth domain/length/finite values and exact membership/DNA. Permissive settings are upstream test parameters, not production defaults or independent MAG-quality truth.'}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--fixture', type=Path, required=True)
+    parser.add_argument('--products', type=Path, required=True)
+    parser.add_argument('--mode', choices=['default-empty', 'upstream-nonempty'], required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = check(args.fixture, args.products, args.mode)
+    result['source_sha256'] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    args.output.write_text(json.dumps(result, indent=2) + '\n')
+    print('PASS independent MetaBAT2 DNA/membership/depth oracle;', result['bins'], 'bins')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/check_longread_native.py b/tests/check_longread_native.py
new file mode 100644
--- /dev/null
+++ b/tests/check_longread_native.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Independent SAM/count/DNA oracle for the long-read execution fixture.
+
+SAM is exported by SAMtools; production consumes BAM through Rsamtools. No
+production parser is imported. This checks evidence counts, not host biology.
+"""
+import argparse
+from collections import defaultdict
+import csv
+import gzip
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+
+
+def text_file(path):
+    return gzip.open(path, 'rt') if str(path).endswith('.gz') else Path(path).open()
+
+
+def fasta(path):
+    result = {}
+    name = None
+    with text_file(path) as stream:
+        for line in stream:
+            if line.startswith('>'):
+                name = line[1:].split()[0]
+                assert name not in result, 'Duplicate FASTA ID'
+                result[name] = ''
+            elif line.strip():
+                assert name is not None
+                result[name] += line.strip()
+    assert result and all(result.values())
+    return result
+
+
+def check(assembly, plasmids, reads, sam, links, sample, control=None):
+    source, selected = fasta(assembly), fasta(plasmids)
+    assert list(selected) == list(source)[:5], 'First-five partition differs'
+    assert all(dna == source[key] for key, dna in selected.items()), 'Partition DNA differs'
+    read_ids = set()
+    with text_file(reads) as stream:
+        while True:
+            header = stream.readline()
+            if not header:
+                break
+            dna, plus, quality = stream.readline().strip(), stream.readline(), stream.readline().strip()
+            assert header.startswith('@') and plus.startswith('+') and len(dna) == len(quality)
+            name = header[1:].split()[0]
+            assert name not in read_ids, 'Duplicate FASTQ ID'
+            read_ids.add(name)
+    references, groups = {}, defaultdict(lambda: [set(), set()])
+    accepted = 0
+    with text_file(sam) as stream:
+        for line in stream:
+            if line.startswith('@SQ\t'):
+                fields = dict(cell.split(':', 1) for cell in line.rstrip().split('\t')[1:])
+                assert fields['SN'] not in references
+                references[fields['SN']] = int(fields['LN'])
+            elif not line.startswith('@') and line.strip():
+                row = line.rstrip('\n').split('\t')
+                assert len(row) >= 11 and row[0] in read_ids
+                flag, mapq = int(row[1]), int(row[4])
+                # Contract defaults: unpaired primary/supplementary, MAPQ>=20.
+                if flag & (0x4 | 0x100 | 0x200 | 0x400 | 0x1) or mapq < 20:
+                    continue
+                assert row[2] in source
+                assert re.fullmatch(r'(?:[0-9]+[MIDNSHP=X])+', row[5])
+                accepted += 1
+                groups[row[0]][bool(flag & 0x800)].add(row[2])
+    assert references == {key: len(dna) for key, dna in source.items()}, 'SAM reference domain/length differs'
+    assert accepted > 0
+    supporting = defaultdict(set)
+    for qname, (primary, supplementary) in groups.items():
+        if not primary or not supplementary:
+            continue
+        targets = primary | supplementary
+        for plasmid in targets.intersection(selected):
+            for host in targets.difference(selected).intersection(source):
+                supporting[plasmid, host].add(qname)
+    expected = {key: len(value) for key, value in supporting.items() if len(value) >= 2}
+    if control:
+        truth = json.loads(Path(control).read_text())
+        assert truth['kind'] == 'synthetic_spanning_read_execution_control'
+        assert expected == {(truth['plasmid_id'], truth['host_id']): 2}, 'Known spanning-read control missing'
+    with Path(links).open() as stream:
+        reader = csv.DictReader(stream, delimiter='\t')
+        assert reader.fieldnames == ['plasmid_id', 'host_id', 'sample_id', 'evidence_type', 'score', 'supporting_data']
+        table = list(reader)
+    assert len(table) == len(expected)
+    actual = {(row['plasmid_id'], row['host_id']): row for row in table}
+    assert len(actual) == len(table) and set(actual) == set(expected), 'Link domain differs'
+    for key, count in expected.items():
+        row = actual[key]
+        assert row['sample_id'] == sample and row['evidence_type'] == 'long_read_bridge'
+        assert row['score'] == str(count)
+        notes = dict(cell.split('=', 1) for cell in row['supporting_data'].split(';'))
+        assert notes['host_id_type'] == 'contig' and int(notes['bridging_reads']) == count
+        strength = count / ((len(source[key[0]]) / 1000) * (len(source[key[1]]) / 1000))
+        assert math.isfinite(float(notes['strength'])) and math.isclose(float(notes['strength']), strength, rel_tol=5e-4)
+        ranked = sorted({n for (plasmid, _), n in expected.items() if plasmid == key[0]}, reverse=True)
+        assert int(notes['host_rank']) == ranked.index(count) + 1
+    return {'pass': True, 'accepted_alignments': accepted, 'input_reads': len(read_ids),
+            'expected_links': [{'plasmid_id': p, 'host_id': h, 'reads': n} for (p, h), n in sorted(expected.items())],
+            'known_positive_control': bool(control),
+            'scope': 'Native evidence-count/DNA/reference contract; upstream minigut and the explicit positive control are synthetic, no host biology/accuracy claim'}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ['assembly', 'plasmids', 'reads', 'sam', 'links', 'output']:
+        parser.add_argument('--' + name, type=Path, required=True)
+    parser.add_argument('--sample-id', default='minigut_ont')
+    parser.add_argument('--control-manifest', type=Path)
+    args = parser.parse_args()
+    result = check(args.assembly, args.plasmids, args.reads, args.sam, args.links, args.sample_id, args.control_manifest)
+    result['source_sha256'] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+    args.output.write_text(json.dumps(result, indent=2) + '\n')
+    print('PASS independent long-read evidence oracle; links', len(result['expected_links']))
+
+
+if __name__ == '__main__':
+    main()
