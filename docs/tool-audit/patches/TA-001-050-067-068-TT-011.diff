+++ b/tests/run_opera_ms_native.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""Run the original OPERA-MS module with a fixed, real native installation."""
+import argparse
+import csv
+import hashlib
+import json
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def fasta(path):
+    records = {}
+    rid = None
+    for line in path.read_text().splitlines():
+        if line.startswith('>'):
+            rid = line[1:].split()[0]
+            assert rid and rid not in records
+            records[rid] = ''
+        else:
+            assert rid is not None
+            records[rid] += line.strip().upper()
+    assert records and all(seq and re.fullmatch('[ACGTRYSWKMBDHVN]+',seq) for seq in records.values())
+    return records
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--work-dir',type=Path,required=True)
