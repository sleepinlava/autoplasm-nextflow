+def fasta(path):
+    with (gzip.open(path, 'rt') if path.suffix == '.gz' else path.open()) as stream:
+        records = {}
+        for line in stream:
+            if line.startswith('>'):
+                cid = line[1:].split()[0]
+                assert cid not in records
+                records[cid] = ''
+            else:
+                records[cid] += line.strip()
+    return records
+
+
