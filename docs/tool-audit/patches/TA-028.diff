+import random
+import re
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def gene_hits(path):
+    result = []
+    for value in json.loads(path.read_text()).values():
+        if isinstance(value, dict):
+            result += [hit for hit in value.values() if isinstance(hit, dict) and 'ARO_name' in hit]
+    return result
+
+
