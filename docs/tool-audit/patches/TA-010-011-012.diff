+/* Separate from local sample coverage: cross-sample method policy. */
+process {
+    withName: 'BOWTIE2_ALIGN_SHARED' {
+        ext.prefix = { "${meta.id}.shared" }
+    }
+    withName: 'MINIMAP2_ALIGN_SHARED' {
+        ext.prefix = { "${meta.id}.shared" }
+        ext.args = { "-ax ${meta.preset}" }
+    }
+    withName: 'SAMTOOLS_VIEW_SHARED' {
+        ext.prefix = { "${meta.id}.shared.eligible" }
+        ext.args = "-b -F 2308 -q 10 -e 'mapq != 255'"
+    }
+    withName: 'COVERM_SHARED' {
+        ext.prefix = { "${meta.id}.shared.coverm" }
+        ext.suffix = '.tsv'
+        ext.args = '--methods mean tpm rpkm count --min-covered-fraction 0 --contig-end-exclusion 0 --exclude-supplementary'
+        publishDir = [path: { "${params.outdir}/10_abundance/shared_reference/coverm" }, mode: params.publish_dir_mode ?: 'copy']
+    }
+}
