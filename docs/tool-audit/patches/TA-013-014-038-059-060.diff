+            trace=project/(step+'.trace.tsv');cmd=[shutil.which('nextflow') or 'nextflow','-C',str(config),'run',str(project/'main.nf'),'-work-dir',str(project/'work'),'-with-trace',str(trace),'-ansi-log','false']
