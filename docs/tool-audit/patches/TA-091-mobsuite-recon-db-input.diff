diff --git 1/tests/nextflow/mobsuite_prepared.nf 2/tests/nextflow/mobsuite_prepared.nf
new file mode 100644
index 0000000..9d8ad74
--- /dev/null
+++ 2/tests/nextflow/mobsuite_prepared.nf
@@ -0,0 +1,21 @@
+include { MOBSUITE_TYPER } from '../../modules/nf-core/mobsuite/typer/main'
+include { MOBSUITE_RECON } from '../../modules/nf-core/mobsuite/recon/main'
+
+// Native prepared-resource integration check: production modules with the
+// controlled 3.1.8 DB. TYPER receives the DB as an explicit input; RECON
+// receives it via ext.args --database_directory (its implicit-DB boundary is
+// a recorded TA-091 aspect, not changed here). No mob_init, no default dir.
+workflow {
+    db = file(params.mobsuite_db, checkIfExists: true)
+    helper = Channel.value(file("${projectDir}/../../bin/mobsuite_preflight.py", checkIfExists: true))
+    MOBSUITE_TYPER(
+        Channel.of(tuple([id: 'typer-native'], file(params.mobsuite_typer_fasta, checkIfExists: true))),
+        Channel.of(tuple(db, 'sha256-controlled-3.1.8-db')),
+        Channel.value([]), Channel.value([]), Channel.value([]),
+        Channel.value([]), Channel.value([]), Channel.value([]),
+        Channel.value([]), true, true, helper)
+    MOBSUITE_RECON(
+        Channel.of(tuple([id: 'recon-native'], file(params.mobsuite_recon_fasta, checkIfExists: true))),
+        Channel.of(tuple(db, 'sha256-controlled-3.1.8-db')),
+        helper)
+}
