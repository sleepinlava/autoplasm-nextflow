        {
          "line": 355,
          "text": "def write_bins(namelist, contig_labels, output, contig_seqs,"
        },
        {
          "line": 356,
          "text": "               minfasta = 200000, output_tag=None, output_compression='none'):"
        },
        {
          "line": 357,
          "text": "    '''"
        },
        {
          "line": 358,
          "text": "    Write binned FASTA files"
        },
        {
          "line": 359,
          "text": ""
        },
        {
          "line": 360,
          "text": "    Returns: DataFrame with information on the bins"
        },
        {
          "line": 361,
          "text": "    '''"
        },
        {
          "line": 362,
          "text": "    from collections import defaultdict"
        },
        {
          "line": 363,
          "text": "    import pandas as pd"
        },
        {
          "line": 364,
          "text": ""
        },
        {
          "line": 365,
          "text": "    res = defaultdict(list)"
        },
        {
          "line": 366,
          "text": "    for label, name in zip(contig_labels, namelist, strict=True):"
        },
        {
          "line": 367,
          "text": "        if label != -1:"
        },
        {
          "line": 368,
          "text": "            res[label].append(name)"
        },
        {
          "line": 369,
          "text": ""
        },
        {
          "line": 370,
          "text": "    os.makedirs(output, exist_ok=True)"
        },
        {
          "line": 371,
          "text": ""
        },
        {
          "line": 372,
          "text": "    written = []"
        },
        {
          "line": 373,
          "text": "    for label, contigs in res.items():"
        },
        {
          "line": 374,
          "text": "        sizes = [len(contig_seqs[contig]) for contig in contigs]"
        },
        {
          "line": 375,
          "text": "        whole_bin_bp = sum(sizes)"
        },
        {
          "line": 376,
          "text": ""
        },
        {
          "line": 377,
          "text": "        if whole_bin_bp >= minfasta:"
        },
        {
          "line": 378,
          "text": "            if output_tag is None:"
        },
        {
          "line": 379,
          "text": "                ofname = f'bin.{label}.fa'"
        },
        {
          "line": 380,
          "text": "            else:"
        },
        {
          "line": 381,
          "text": "                ofname = f'{output_tag}_{label}.fa'"
        },
        {
          "line": 382,
          "text": "            ofname = os.path.join(output, ofname)"
        },
        {
          "line": 383,
          "text": "            if output_compression != 'none':"
        },
        {
          "line": 384,
          "text": "                ofname += '.' + output_compression"
        },
        {
          "line": 385,
          "text": "            n50, l50 = n50_l50(sizes)"
        },
        {
          "line": 386,
          "text": "            written.append([ofname, whole_bin_bp, len(contigs), n50, l50])"
        },
        {
          "line": 387,
          "text": "            with possibly_compressed_write(ofname) as ofile:"
        },
        {
          "line": 388,
          "text": "                for contig in contigs:"
        },
        {
          "line": 389,
          "text": "                    ofile.write(f'>{contig}\\n{contig_seqs[contig]}\\n')"
        },
        {
          "line": 390,
          "text": "    return pd.DataFrame(written, columns=['filename', 'nbps', 'nr_contigs', 'N50', 'L50'])"
        },
        {
