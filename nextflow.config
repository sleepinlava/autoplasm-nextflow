/*
 * AutoPlasm Nextflow configuration.
 * All pipeline parameters and their defaults are defined in this file.
 */

params {
    // ---- project ----
    project_name    = 'plasmid_analysis'
    outdir          = 'results/plasmid_analysis'
    samplesheet     = null
    platform        = 'illumina'      // illumina | ont | pacbio_hifi | hybrid | assembly
    publish_dir_mode = 'copy'
    protocol_min_breadth = 0.75
    protocol_min_depth = 1.0
    protocol_bin_score_threshold = 0.7
    protocol_max_mismatch_rate = 0.02
    protocol_protein_identity = 0.5
    protocol_protein_coverage = 0.8
    protocol_complete_ids = null             // independently confirmed frozen representative IDs, one per line
    protocol_host_models = false
    mostplas_source = null                  // upstream MOSTPLAS checkout with checkpoint and genus_index.txt
    mostplas_threshold = 0.4
    plsdb_fasta = null
    plsdb_hosts = null                       // TSV: reference_id, host_taxonomy
    plsdb_identity = 0.99
    plsdb_coverage = 0.90
    protocol_mag_min_completeness = 50
    protocol_mag_max_contamination = 10
    protocol_host_strata = 'group'
    protocol_host_subject = null
    protocol_host_bootstraps = 1000
    protocol_arg_window = 10000
    protocol_evolution = false
    protocol_tree_min_members = 4
    protocol_tree_min_core = 3
    protocol_strain = false
    protocol_strain_min_coverage = 5
    protocol_strain_min_locus_fraction = 0.75
    protocol_strain_ani = 0.99999
    protocol_strain_min_compared_bases = 10000
    short_read_protocol = false
    catalogue_identity = 0.99
    catalogue_coverage = 0.90
    beta_normalization = 'none'
    ecology_formula = 'group'
    ecology_block = null
    ecology_permutations = 999
    run_ancombc2 = false
    ancombc2_formula = 'group'
    ancombc2_random_formula = null
    ancombc2_prevalence = 0.10

    // ---- basecalling (00) ----
    dorado_model    = 'hac'

    // ---- QC (01): qc.run_fastqc / qc.run_multiqc ----
    run_fastqc      = false
    run_multiqc     = true
    filtlong_min_length  = 1000
    filtlong_keep_percent = 90

    // ---- host removal (optional): host_removal.host_reference ----
    // global fallback; the samplesheet host_reference column overrides per sample
    host_reference  = null

    // ---- assembly (02) ----
    short_read_assembler = 'megahit'        // megahit | metaspades
    long_read_assembler  = 'metaflye'
    pacbio_hifi_assembler = 'hifiasm_meta'
    hybrid_assembler     = 'opera_ms'       // opera_ms | hybridspades
    min_contig_length    = 500
    megahit_memory_bytes = 96636764160      // ~90 GB assembly memory cap

    // ---- polishing (03): polishing.tools ----
    polishing_tools = []                    // e.g. ['medaka']

    // ---- plasmid detection (04): plasmid_detection ----
    plasmid_detection_tools = ['genomad']   // + plasme, plasx, platon
    consensus_method = 'weighted_vote'      // intersection | majority_vote | weighted_vote | single_tool
    consensus_weights = 'genomad:0.6,platon:0.15,plasme:0.15,plasx:0.1'

    // ---- plasmid binning (05): plasmid_binning.tools ----
    plasmid_binning_tools = []              // plasmaag, gplas2, mob_recon, recycler
    plasmaag_source = null
    plasmaag_genomad_splits = 0              // native default; optional explicit memory partitions
    plasmaag_vamb_arguments = null          // native defaults; fixture exceptions must be explicit
    plasmaag_conda_prefix = null            // optional persistent Snakemake deployment cache
    gplas_source = null                    // prepared fixed00cf37b source + generated SCM version

    // ---- typing (06): typing.tools / typing.optional_tools ----
    typing_tools          = ['plasmidfinder', 'mob_typer']
    typing_optional_tools = []              // copla, conjscan, macsyfinder

    // ---- host prediction (07): host_prediction.tools ----
    host_prediction_tools = ['metaphlan']   // + kraken2 (illumina), plasmidhostfinder (assembly)

    // ---- MAG host genomes (07/mag): mag_host_genomes.tools ----
    mag_tools = []                          // metabat2, concoct, semibin, das_tool, checkm2, gtdbtk

    // ---- host-plasmid linking (07): host_plasmid_linking ----
    host_plasmid_linking         = false
    host_linking_methods         = ['co_abundance']   // + sequence, long_read
    host_linking_optional_methods = []                 // crispr, hotspot
    link_correlation_method      = 'spearman'          // spearman | pearson
    link_min_correlation         = 0.6
    // Legacy exploratory cutoff; uncalibrated for tetra_markov256_v1.
    link_min_similarity          = 0.7
    // HOTSPOT (optional method 'hotspot'): cloned repository + downloaded
    // database/models folders (see https://github.com/Orin-beep/HOTSPOT)
    hotspot_home                 = ''
    hotspot_db                   = ''
    hotspot_models               = ''

    // ---- annotation (08): annotation.tools / annotation.optional_tools ----
    annotation_tools          = ['bakta', 'amrfinderplus', 'isescan', 'integronfinder']
    annotation_optional_tools = []            // prodigal, abricate, rgi, eggnog_mapper, mob_suite
    abricate_db               = 'card'

    // ---- comparative genomics (09): comparative_genomics ----
    comparative_tools          = ['mmseqs2']
    comparative_optional_tools = []           // blast, mummer, clinker
    mmseqs2_min_seq_id         = 0.95
    mmseqs2_min_cov            = 0.8

    // ---- cross-sample (11/12): sample_analysis / network ----
    run_diversity             = true
    min_diversity_samples     = 3
    run_differential_internal = true
    run_differential_deseq2   = false
    min_group_replicates      = 3
    run_network               = false
    network_min_samples       = 20

    // ---- databases ----
    genomad_db          = null
    bakta_db            = null
    mob_suite_db        = null
    plasmidfinder_db    = null
    metaphlan_db        = null
    amrfinderplus_db    = null
    card_db             = null
    kraken2_db          = null
    gtdbtk_db           = null
    checkm2_db          = null
    plasme_db           = null
    plasme_dir          = null    // fixed source checkout with PLASMe.py and its helper modules
    plasme_container    = null    // optional OCI/SIF override; default local image built from containers/plasme
    plasx_annotations   = null  // retired shared annotation input; rejected when PlasX is selected
    plasx_anvio_source  = null  // fixed anvi'o 7.1 source tree
    plasx_source        = null  // fixed PlasX source tree
    plasx_cog_db        = null  // anvi'o COG base directory containing COG14/
    plasx_pfam_db       = null  // prepared Pfam32.0 directory
    plasx_profiles      = null  // complete official de novo MMseqs2 profiles
    plasx_splits        = 32    // resource partition only; all ten identity levels remain enabled
    plasx_model         = null
    platon_db           = null
    copla_refgraph      = null
    copla_reflist       = null
    copla_dir           = null    // prepared official source/bin/databases, including all listed reference FASTAs
    copla_macsyfinder_dir = null   // separate Python2 MacSyFinder1.0.5 prefix
    blast_db            = null
    reference_plasmids  = null
    plasmidhostfinder_db = null
    eggnog_db           = null

    // ---- generic ----
    max_cpus   = 16
    max_memory = '120.GB'
    max_time   = '48.h'
}

// Per-process resource labels
process {
    errorStrategy = 'terminate'

    withLabel: process_single {
        cpus   = 1
        memory = '2.GB'
        time   = '1.h'
    }
    withLabel: process_low {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = '16.GB'
        time   = '8.h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = '64.GB'
        time   = '24.h'
    }
    withLabel: process_highmem {
        cpus   = 16
        memory = '120.GB'
        time   = '48.h'
    }
}

// Domain configs for vendored nf-core modules (publishDir, ext.args, ext.prefix)
includeConfig 'conf/nfcore_upstream.config'
includeConfig 'conf/shared_quantification.config'
includeConfig 'conf/nfcore_qc_assembly.config'
includeConfig 'conf/nfcore_detection.config'
includeConfig 'conf/gplas.config'
includeConfig 'conf/nfcore_downstream.config'
includeConfig 'conf/nfcore_mag.config'
includeConfig 'conf/nfcore_host_comparative.config'

profiles {
    short_read_protocol {
        includeConfig 'conf/short_read_protocol.config'
    }
    conda {
        conda.enabled  = true
        conda.useMamba = false
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
    }
    podman {
        // SELinux hosts need bind mounts relabelled; tests/nf-test/env.sh puts a
        // podman shim on PATH that appends :z to -v/--volume specs.
        podman.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name        = 'autoplasm-nextflow'
    description = 'AutoPlasm — metagenomic plasmid analysis pipeline (Nextflow DSL2)'
    version     = '1.0.0'
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}

includeConfig 'conf/plasmaag.config'
