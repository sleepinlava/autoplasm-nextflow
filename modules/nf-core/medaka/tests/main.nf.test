nextflow_process {

    name "Test Process MEDAKA"
    tag "modules_nfcore"
    tag "modules"
    tag "medaka"
    script "../main.nf"
    process "MEDAKA"

    // User excludes viral elements. All three fixture paths must come from
    // a complete reviewed bacterial ONT case and an independent full reference.
    // Native prepared case remains required and unexecuted.
    test("Medaka - complete bacterial prepared case") {

        tag "medaka-native-prepared"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.medaka_bacterial_reads, checkIfExists: true),
                    file(params.medaka_bacterial_assembly, checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    def expected = new File(params.medaka_bacterial_expected_fasta.toString()).readLines()
                    assert expected.any { it.startsWith('>') }
                    assert expected.findAll { !it.startsWith('>') }.join('').size() > 0
                    // Exact complete reference, including sequence IDs and DNA;
                    // no first-100-base or automatically re-recorded snapshot.
                    assert path(process.out.assembly[0][1]).linesGzip == expected
                    assert process.out.versions_medaka[0][2] == '2.2.2'
                }
            )
        }

    }

    test("Medaka - bacterial stub interface") {

        tag "medaka-bacterial-stub"

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.medaka_bacterial_reads, checkIfExists: true),
                    file(params.medaka_bacterial_assembly, checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.assembly[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match("stub_outputs")
                }
            )
        }

    }

}
