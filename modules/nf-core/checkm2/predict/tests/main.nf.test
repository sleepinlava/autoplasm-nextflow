nextflow_process {

    name "Test Process CHECKM2_PREDICT"
    tag "modules_nfcore"
    tag "modules"
    tag "checkm2"
    tag "checkm2/predict"
    script "modules/nf-core/checkm2/predict/main.nf"
    process "CHECKM2_PREDICT"

    test("test_checkm2_predict") {
        config "./nextflow.config"
        when {
            params {
                outdir = "${launchDir}/tests/results"
            }
            process {
                """
                def ResourceIdentity = new GroovyClassLoader().parseClass(new File("${new File('lib/ResourceIdentity.groovy').absolutePath}"))
                def resource = { value ->
                    if (!value) return tuple([], [schema_version: 2, resource_state: 'absent'])
                    def root = file(value, checkIfExists: true)
                    tuple(root, ResourceIdentity.capture(root))
                }

                input[0] = [ [id: 'test'], [file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)] ]
                input[1] = ([ [id: 'checkm2_small_db'], file(params.modules_testdata_base_path + 'delete_me/binette_checkm2/binette_checkm2_small_db.dmnd', checkIfExists: true) ]).with { value -> resource.call(value[1]).with { r -> tuple(value[0], r[0], r[1]) } }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.checkm2_tsv, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }
    }

    test("test_checkm2_predict - stub") {

        options '-stub'

        when {
            params {
                outdir = "${launchDir}/tests/results"
            }
            process {
                """
                def ResourceIdentity = new GroovyClassLoader().parseClass(new File("${new File('lib/ResourceIdentity.groovy').absolutePath}"))
                def resource = { value ->
                    if (!value) return tuple([], [schema_version: 2, resource_state: 'absent'])
                    def root = file(value, checkIfExists: true)
                    tuple(root, ResourceIdentity.capture(root))
                }

                input[0] = [ [id: 'test'], [file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz', checkIfExists: true)] ]
                input[1] = ([ [id: 'checkm2_small_db'], file(params.modules_testdata_base_path + 'delete_me/binette_checkm2/binette_checkm2_small_db.dmnd', checkIfExists: true) ]).with { value -> resource.call(value[1]).with { r -> tuple(value[0], r[0], r[1]) } }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.checkm2_tsv, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }
    }
}
