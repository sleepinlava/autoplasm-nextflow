nextflow_workflow {
    name "Test ABRicate with fresh native runtime resource identity"
    script "./main.nf"
    workflow "ABRICATE_RUNTIME_TEST"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "abricate"
    tag "abricate/run"

    test("bacteroides_fragilis - genome.fa.gz") {
        when {
            workflow {
                """
                input[0] = Channel.value([
                    [id:'test',single_end:false],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz',checkIfExists:true)
                ])
                input[1] = Channel.value([])
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.report.size() == 1
            def report = new File(workflow.out.report.get(0).get(1).toString())
            // Keep the original native report oracle; process namespace is
            // plumbing and is checked separately from scientific bytes.
            assert java.security.MessageDigest.getInstance('MD5').digest(report.bytes).encodeHex().toString() == 'b48f4f5f78982a221038fd9f0a3aa504'
            assert report.readLines().first().tokenize('\t').size() == 15
            assert workflow.out.report.get(0).get(0).id == 'test'
            assert workflow.out.versions_abricate.get(0).get(2) == '1.0.1'
        }
    }
    test("bacteroides_fragilis - genome.fa.gz - stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = Channel.value([
                    [id:'test',single_end:false],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/bacteroides_fragilis/genome/genome.fna.gz',checkIfExists:true)
                ])
                input[1] = Channel.value([])
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.report.size() == 1
            assert new File(workflow.out.report.get(0).get(1).toString()).length() == 0
            assert workflow.out.versions_abricate.get(0).get(2) == '1.0.1'
        }
    }
}
