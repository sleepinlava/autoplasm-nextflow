nextflow_process {
    name "MOB typer guarded entrypoint"
    script "../main.nf"
    process "MOBSUITE_TYPER"
    tag "modules"
    tag "modules_nfcore"
    tag "mobsuite"
    // Viral fixture retired by user. Native full bacterial scientific case
    // awaits prepared complete resources; stub is not its replacement.
    test("full bacterial assembly - native prepared resources required") {
        tag "mobsuite-native-prepared"
        when {
            process {
                """
                input[0]=[[id:'test'],file(params.mobsuite_bacterial_fasta,checkIfExists:true)]
                input[1]=[file(params.mobsuite_db.toString(),checkIfExists:true),[schema_version:2,resource_state:'provided']]
                input[2]=[]; input[3]=[]; input[4]=[]; input[5]=[]
                input[6]=[]; input[7]=[]; input[8]=[]
                input[9]=true; input[10]=true
                input[11]=file(projectDir.resolve('bin/mobsuite_preflight.py'),checkIfExists:true)
                """
            }
        }
        then {
            assert process.success
            def fastaPath=System.getenv('MOBSUITE_BACTERIAL_FASTA')
            assert fastaPath!=null
            def input=new File(fastaPath).readLines()
            assert input.count { it.startsWith('>') }==1
            def dna=input.findAll { !it.startsWith('>') }.join('')
            assert dna.size()>450000
            def products=process.out.report.get(0).get(1)
            def files=products instanceof List ? products : [products]
            def report=files.find { new File(it.toString()).name=='test.txt' }
            assert report!=null
            def rows=new File(report.toString()).readLines().findAll { it.trim() }
            assert rows.size()==2
            def header=rows[0].split('\t',-1).toList()
            def values=rows[1].split('\t',-1).toList()
            assert values[header.indexOf('num_contigs')]=='1'
            assert values[header.indexOf('size')].toLong()==dna.size()
            assert values[header.indexOf('md5')]==java.security.MessageDigest.getInstance('MD5').digest(dna.bytes).encodeHex().toString()
            assert process.out.versions_mobsuite.get(0).get(2)=='3.1.9'
        }
    }
    test("full bacterial input - stub interface") {
        tag "mobsuite-guard-stub"
        options "-stub"
        when {
            process {
                """
                input[0]=[[id:'test'],file(params.mobsuite_bacterial_fasta,checkIfExists:true)]
                input[1]=[[],[schema_version:2,resource_state:'absent']]
                input[2]=[]; input[3]=[]; input[4]=[]; input[5]=[]
                input[6]=[]; input[7]=[]; input[8]=[]
                input[9]=true; input[10]=true
                input[11]=file(projectDir.resolve('bin/mobsuite_preflight.py'),checkIfExists:true)
                """
            }
        }
        then {
            assert process.success
            def products=process.out.report.get(0).get(1)
            def files=products instanceof List ? products : [products]
            assert files.size()==3
            assert files.every { new File(it.toString()).length()==0 }
            assert process.out.versions_mobsuite.get(0).get(2)=='3.1.9'
        }
    }
}
