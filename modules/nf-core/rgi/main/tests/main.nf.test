nextflow_process {

    name "Test Process RGI_MAIN"
    script "../main.nf"
    process "RGI_MAIN"

    tag "modules"
    tag "modules_nfcore"
    tag "rgi"
    tag "rgi/main"
    tag "rgi/cardannotation"
    tag "untar"

    setup {
        run("UNTAR") {
            script "tests/nf-test/prerequisites/nf-core/untar/main.nf"
            process {
            """
            file('https://card.mcmaster.ca/latest/data', checkIfExists: true).copyTo('card-data.tar.bz2')

            input[0] = [
                [ ],
                file("card-data.tar.bz2")
            ]
            """
            }
        }

        run("RGI_CARDANNOTATION") {
            script "tests/nf-test/prerequisites/nf-core/rgi/cardannotation/main.nf"
            process {
                """
                input[0] = UNTAR.out.untar.map{ it[1] }
                """
            }
        }
    }


    test("rgi/main - haemophilus_influenzae - genome_fna_gz") {

        when {
            process {
                """
                def ResourceIdentity = new GroovyClassLoader().parseClass(new File("${new File('lib/ResourceIdentity.groovy').absolutePath}"))
                def resource = { value ->
                    if (!value) return tuple([], [schema_version: 2, resource_state: 'absent'])
                    def root = file(value, checkIfExists: true)
                    tuple(root, ResourceIdentity.capture(root))
                }

                input[3] = file("${new File('bin/validate_rgi_card.py').absolutePath}", checkIfExists: true)
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true)
                ]
                input[1] = RGI_CARDANNOTATION.out.db.map { resource.call(it) }
                input[2] = resource.call([])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["tmp"])).match() }
            )
        }
    }

    test("rgi/main - haemophilus_influenzae - genome_fna_gz - stub") {

        options "-stub"

        when {
            process {
                """
                def ResourceIdentity = new GroovyClassLoader().parseClass(new File("${new File('lib/ResourceIdentity.groovy').absolutePath}"))
                def resource = { value ->
                    if (!value) return tuple([], [schema_version: 2, resource_state: 'absent'])
                    def root = file(value, checkIfExists: true)
                    tuple(root, ResourceIdentity.capture(root))
                }

                input[3] = file("${new File('bin/validate_rgi_card.py').absolutePath}", checkIfExists: true)
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/haemophilus_influenzae/genome/genome.fna.gz', checkIfExists: true)
                ]
                input[1] = RGI_CARDANNOTATION.out.db.map { resource.call(it) }
                input[2] = resource.call([])
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
