nextflow_process {

    name "Test Process SEMIBIN_SINGLEEASYBIN"

    script "../main.nf"
    process "SEMIBIN_SINGLEEASYBIN"

    tag "modules"
    tag "modules_nfcore"
    tag "semibin"
    tag "semibin/singleeasybin"
    config './nextflow.config'

    test("metagenome - binning") {

        when {
            params {
                module_args  = ''
                module_args2 = '--ml-threshold 0 --minfasta-kbs 0 --min-len 0 --random-seed 0'
            }
            process {
                """
                input[1] = file("${new File('bin/semibin_output_state.py').absolutePath}", checkIfExists: true)
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/contigs.fasta.gz', checkIfExists:true),
                    [
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s1.sorted.bam', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s2.sorted.bam', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s3.sorted.bam', checkIfExists:true)
                    ]
                ]
                """
            }
        }
        then {
            assert process.success
            assert process.out.model.size() == 1
            def modelValue = process.out.model.get(0).get(1)
            def modelFiles = modelValue instanceof List ? modelValue : [modelValue]
            assert modelFiles.size() == 1 && path(modelFiles[0]).name.endsWith('.pt')
            assert path(modelFiles[0]).size() > 0
            def stateValue = process.out.state.get(0).get(1)
            def stateFiles = stateValue instanceof List ? stateValue : [stateValue]
            assert stateFiles.size() == 1
            def state = new groovy.json.JsonSlurper().parseText(path(stateFiles[0]).text)
            assert state.state == 'bins_ready'
            def binValue = process.out.output_fasta.get(0).get(1)
            def binFiles = binValue instanceof List ? binValue : [binValue]
            assert state.bin_count == binFiles.size()
            def bins = binFiles.collect { path(it).fasta }
            def featurised = path(process.out.csv.get(0).get(1).find { it.endsWith('/data.csv') })
                .readLines().drop(1).collect { it.split(',')[0] }
            assertAll(
                // every contig SemiBin featurised lands in exactly one bin. Which bin varies between machines
                { assert featurised && bins.collectMany { it.keySet().toList() }.sort() == featurised.sort() },
                { assert process.out.csv.get(0).get(1).collect { file(it).name }.toSet() == ['data.csv', 'data_split.csv', 's1.sorted.bam_0_data_cov.csv', 's2.sorted.bam_1_data_cov.csv', 's3.sorted.bam_2_data_cov.csv'].toSet() },
                { assert process.out.tsv.get(0).get(1).collect { file(it).name }.toSet() == ['contig_bins.tsv', 'recluster_bins_info.tsv'].toSet() },
                { assert process.out.versions_semibin.size() == 1 && process.out.versions_semibin.get(0).get(2) == '2.4.1' },
                { assert process.out.versions_cuda.size() == 1 && process.out.versions_cuda.get(0).get(2) == 'no CUDA available' }

            )
        }
    }

    test("metagenome - binning - stub") {
        options '-stub'
        when {
            params {
                module_args  = ''
                module_args2 = '--ml-threshold 0 --minfasta-kbs 0 --min-len 0 --random-seed 0'
            }
            process {
                """
                input[1] = file("${new File('bin/semibin_output_state.py').absolutePath}", checkIfExists: true)
                input[0] = [
                    [id:'test'],
                    file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/contigs.fasta.gz', checkIfExists:true),
                    [
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s1.sorted.bam', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s2.sorted.bam', checkIfExists:true),
                        file(params.modules_testdata_base_path + 'genomics/prokaryotes/metagenome/binning/s3.sorted.bam', checkIfExists:true)
                    ]
                ]
                """
            }
        }
        then {
            assert process.success
            assert process.out.output_fasta.size() == 0
            assert process.out.model.size() == 0
            def stateValue = process.out.state.get(0).get(1)
            def stateFiles = stateValue instanceof List ? stateValue : [stateValue]
            assert stateFiles.size() == 1
            def state = new groovy.json.JsonSlurper().parseText(path(stateFiles[0]).text)
            assert state.state == 'stub_not_validated'
            assert state.bin_count == null

        }
    }

}
